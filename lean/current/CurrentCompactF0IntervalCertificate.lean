      ∑ k : Fin 6,
        f0ScaledEntries i k *
          (if 0 ≤ f0ScaledEntries i k
           then lowerIntervalTable n.castSucc k j
           else upperIntervalTable n.castSucc k j) ∧
    (∑ k : Fin 6,
       f0ScaledEntries i k *
         (if 0 ≤ f0ScaledEntries i k
          then upperIntervalTable n.castSucc k j
          else lowerIntervalTable n.castSucc k j)) ≤
      f0SourceScale * upperIntervalTable n.succ i j

/-- Checks the strict row-sum bound for every n < 48, using upper
absolute endpoints. The factor 10 removes fractional thresholds. -/
private def intervalTransientSpec : Prop :=
  ∀ n : Fin 48, ∀ i : Fin 6,
    10 * (∑ j : Fin 6, max
      |lowerIntervalTable n.castSucc i j|
      |upperIntervalTable n.castSucc i j|) <
      61 * f0IntervalScale

/-- Strict 48-step contraction for all six rows, with outward bounds.
This does not yet assert a statement about the real matrix without the
interval-induction and rational-cast lemmas. -/
private def intervalBlock48Spec : Prop :=
  ∀ i : Fin 6,
    25 * (∑ j : Fin 6, max
      |lowerIntervalTable (48 : Fin 49) i j|
      |upperIntervalTable (48 : Fin 49) i j|) <
      24 * f0IntervalScale

set_option maxRecDepth 8192
set_option maxHeartbeats 0

private theorem intervalBase_verified : intervalBaseSpec := by decide +kernel
private theorem intervalStep_verified : intervalStepSpec := by decide +kernel
private theorem intervalTransient_verified : intervalTransientSpec := by decide +kernel
private theorem intervalBlock48_verified : intervalBlock48Spec := by decide +kernel

#print axioms intervalBase_verified
#print axioms intervalStep_verified
#print axioms intervalTransient_verified
#print axioms intervalBlock48_verified

end CurrentCompact
end Ventura26LiquidityAllocation
