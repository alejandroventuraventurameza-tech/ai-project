import Ventura26LiquidityAllocation.DateZeroCapitalGainContinuityCandidate
import Mathlib.Analysis.SpecialFunctions.Log.Deriv
import Mathlib.Analysis.SpecialFunctions.Pow.Deriv

/-!
# Date-zero capital Euler: analytic primitives and exact finite objective delta

This is the first piece of the promised first-principles Euler calculation.
CRRA has marginal utility c^(-sigma) at every positive c, including the
logarithmic sigma=1 case. The realized date-one capital gain is differentiable
at epsilon=0 from Cobb-Douglas technology with date-zero positive capital.
Finally, since the explicit deviation changes consumption only in periods
zero and one, the discounted sum DELTA is exactly their two utility-term
deltas, not a differentiation of an uncontrolled infinite series.

Next proof obligations: differentiate these two finite date terms, combine
with Fermat from FirmOptimal, then specialize deterministic transitions.

No Euler equation, equilibrium or KKT condition is postulated here.
No original model/source edits and no sorry/admit/custom axioms.
-/

namespace Ventura26LiquidityAllocation
namespace ProposedDateZeroCapitalEulerDerivative

open ProposedDateZeroCapitalDeviation
open ProposedDateZeroCapitalUtility
open ProposedDateZeroCapitalNeighborhood
open ProposedDateZeroCapitalGainContinuity

variable {S : Type*} [Fintype S] [DecidableEq S]

/-- CRRA marginal utility from its source primitive, including logarithmic
    consumption utility when sigma=1. -/
theorem crraUtility_hasDerivAt
    (sigma c : ℝ) (hc : 0 < c) :
    HasDerivAt (fun x : ℝ => crraUtility sigma x)
      (crraMarginal sigma c) c := by
  by_cases hs : sigma = 1
  · subst sigma
    simpa [crraUtility, crraMarginal, Real.rpow_neg_one] using
      (Real.hasDerivAt_log (ne_of_gt hc))
  · have hden : 1 - sigma ≠ 0 := sub_ne_zero.mpr (Ne.symm hs)
    have hpow : HasDerivAt (fun x : ℝ => x ^ (1 - sigma))
        ((1 - sigma) * c ^ ((1 - sigma) - 1)) c :=
      Real.hasDerivAt_rpow_const (Or.inl (ne_of_gt hc))
    have hcalc : HasDerivAt
        (fun x : ℝ => (x ^ (1 - sigma) - 1) / (1 - sigma))
        ((1 - sigma) * c ^ ((1 - sigma) - 1) / (1 - sigma)) c :=
      (hpow.sub_const 1).div_const (1 - sigma)
    have hexp : (1 - sigma) - 1 = -sigma := by ring
    have hcoef :
        (1 - sigma) * c ^ ((1 - sigma) - 1) / (1 - sigma) =
          c ^ (-sigma) := by
      rw [hexp]
      field_simp [hden]
    rw [hcoef] at hcalc
    simpa [crraUtility, hs, crraMarginal] using hcalc

/-- Marginal Cobb-Douglas date-one payoff generated by ONE more unit
    of date-zero capital, excluding utility discounting. -/
noncomputable def dateOneMarginalCapitalPayoff
    (P : Primitives S) (X : Allocation S) (i : FirmType)
    (p : FirmPlan S) (h : History S 1) : ℝ :=
  X.inputPrice 1 h *
      (P.aggregateProductivity (currentState h) * P.productivity i) *
      P.alpha * (p.capital 0 (previousHistory h)) ^ (P.alpha - 1) *
        (p.labor 1 h) ^ P.beta +
    (1 - P.depreciation) * X.capitalPrice 1 h

/-- Derivative of the REALIZED nonlinear capital gain, without replacing
    the original Cobb-Douglas technology by a linear approximation. -/
theorem dateOneCapitalGain_hasDerivAt_zero
    (P : Primitives S) (X : Allocation S) (i : FirmType)
    (p : FirmPlan S) (h : History S 1)
    (hcapital : 0 < p.capital 0 (previousHistory h)) :
    HasDerivAt (fun epsilon : ℝ => dateOneCapitalGain P X i p epsilon h)
      (dateOneMarginalCapitalPayoff P X i p h) 0 := by
  let K : ℝ := p.capital 0 (previousHistory h)
  let A : ℝ := P.aggregateProductivity (currentState h) * P.productivity i
  let Q : ℝ := X.inputPrice 1 h
  let L : ℝ := p.labor 1 h
  let W : ℝ := X.wage 1 h
  let q : ℝ := X.capitalPrice 1 h
  have hK : K ≠ 0 := ne_of_gt hcapital
  have hbase : HasDerivAt (fun epsilon : ℝ => K + epsilon) 1 0 := by
    simpa [add_comm] using ((hasDerivAt_id (0 : ℝ)).const_add K)
  have hpow :
      HasDerivAt (fun epsilon : ℝ => (K + epsilon) ^ P.alpha)
        (P.alpha * K ^ (P.alpha - 1)) 0 := by
    convert hbase.rpow_const (Or.inl (by simpa using hK)) using 1
    · ext epsilon
      rfl
    · simp
  have hprofit :
      HasDerivAt
        (fun epsilon : ℝ =>
          operatingProfit Q A (K + epsilon) L P.alpha P.beta W)
        (Q * A * P.alpha * K ^ (P.alpha - 1) * L ^ P.beta) 0 := by
    have hd := ((hpow.const_mul (Q * A)).mul_const (L ^ P.beta)).sub_const (W * L)
    convert hd using 1
    · ext epsilon
      simp only [operatingProfit, operatingOutput]
      ring
    · ring
  have hgain :=
    (hprofit.sub_const (operatingProfit Q A K L P.alpha P.beta W)).add
      ((hasDerivAt_id (0 : ℝ)).const_mul (q * (1 - P.depreciation)))
  convert hgain using 1
  · ext epsilon
    simp only [dateOneCapitalGain]
    dsimp [K, A, Q, L, W, q]
    ring
  · dsimp [dateOneMarginalCapitalPayoff, K, A, Q, L, q]
    ring

/-- General two-term expansion of an absolutely convergent infinite series.
    The remaining tail has not been truncated or approximated. -/
private theorem tsum_eq_two_terms_and_tail
    (f : ℕ → ℝ) (hf : Summable f) :
    (∑' n : ℕ, f n) =
      f 0 + f 1 + ∑' n : ℕ, f (n + 2) := by
  have htail : Summable (fun n : ℕ => f (n + 1)) :=
    (summable_nat_add_iff 1).mpr hf
  calc
    (∑' n : ℕ, f n) =
        f 0 + (∑' n : ℕ, f (n + 1)) := hf.tsum_eq_zero_add
    _ = f 0 + (f 1 + ∑' n : ℕ, f (n + 2)) := by
      rw [htail.tsum_eq_zero_add]
    _ = f 0 + f 1 + ∑' n : ℕ, f (n + 2) := by ring

/-- Exact cancellation of every infinite-horizon term past date one.
    This is the algebraic bridge needed before differentiating the
    discounted objective with respect to date-zero capital. -/
theorem discountedFirmUtility_capitalVariation_delta_eq
    (P : Primitives S) (X : Allocation S) (i : FirmType)
    (p : FirmPlan S) (epsilon : ℝ)
    (hwell : FirmObjectiveWellDefined P p) :
    discountedFirmUtility P (capitalDateZeroVariation P X i p epsilon) -
        discountedFirmUtility P p =
      (firmUtilityTerm P (capitalDateZeroVariation P X i p epsilon) 0 -
        firmUtilityTerm P p 0) +
      (firmUtilityTerm P (capitalDateZeroVariation P X i p epsilon) 1 -
        firmUtilityTerm P p 1) := by
  let f : ℕ → ℝ := firmUtilityTerm P (capitalDateZeroVariation P X i p epsilon)
  let g : ℕ → ℝ := firmUtilityTerm P p
  have hg : Summable g := hwell
  have hf : Summable f :=
    (capitalVariation_objectiveWellDefined_iff P X i p epsilon).2 hwell
  have hsplitf := tsum_eq_two_terms_and_tail f hf
  have hsplitg := tsum_eq_two_terms_and_tail g hg
  have htail : (∑' n : ℕ, f (n + 2)) = (∑' n : ℕ, g (n + 2)) :=
    tsum_congr (fun n => utilityTerm_later_eq P X i p epsilon n)
  change (∑' n, f n) - (∑' n, g n) =
    (f 0 - g 0) + (f 1 - g 1)
  rw [hsplitf, hsplitg, htail]
  ring

end ProposedDateZeroCapitalEulerDerivative
